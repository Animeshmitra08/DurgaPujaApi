# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins. Use * only for local dev.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# MongoDB Atlas
# ---------------------------------------------------------------------------
MONGODB_URI=

# ---------------------------------------------------------------------------
# Google service account
#
# GOOGLE_PRIVATE_KEY must keep its literal \n sequences when pasted into a
# single-line .env value, e.g.
#   GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# Some hosts (Render, Railway) un-escape it for you; the loader handles both.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Target folder. On a Shared Drive this is a folder inside that drive.
GOOGLE_DRIVE_FOLDER_ID=1F8cUGRuNw9V9DNWYFeqNI_ev_lDBeE5t

# REQUIRED unless you use domain-wide delegation: service accounts have no
# storage quota of their own, so uploads must land on a Shared Drive whose
# quota belongs to the drive. Set this to the Shared Drive's ID.
GOOGLE_SHARED_DRIVE_ID=

# Alternative to a Shared Drive: domain-wide delegation. The service account
# impersonates this Workspace user and consumes that user's quota.
GOOGLE_IMPERSONATE_USER=

# Subfolders of GOOGLE_DRIVE_FOLDER_ID that uploads go to by type when the
# request does not send folderName. Also the folders POST /api/files/sync scans.
DRIVE_IMAGES_FOLDER=images
DRIVE_AUDIOS_FOLDER=audios

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_FILE_SIZE_MB=200

# Absolute or relative path for temporary multer files. Defaults to ./uploads,
# falling back to the OS temp dir when that is not writable.
UPLOAD_TMP_DIR=./uploads

# ---------------------------------------------------------------------------
# API auth (optional)
#
# When set, every write route (upload / patch / replace / delete) requires
# header: x-api-key: <value>. Leave blank to disable auth entirely.
# ---------------------------------------------------------------------------
API_KEY=
